rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // avatars: 認証済みユーザーは自分のアバター画像のみ書き込み可。読み取りは全員可。
    match /avatars/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && fileName.matches(request.auth.uid + '\\.(jpg|jpeg|png|webp)');
    }

    // posts: 認証済みユーザーは投稿画像を書き込み可（パスはposts/{postId}/）。読み取りは全員可。
    match /posts/{postId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && !request.auth.token.firebase.sign_in_provider.matches('anonymous');
    }

    // calendar: 認証済みユーザーは自分のUID配下の画像のみ読み書き可。
    match /calendar/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId
        && !request.auth.token.firebase.sign_in_provider.matches('anonymous');
    }

    // デフォルト: 禁止
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
