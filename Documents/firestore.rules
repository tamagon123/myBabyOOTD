rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    // users: 読み取りは全員可、書き込みは自分のみ
    // followers_count のみの更新は誰でも可（フォロー/アンフォロー時）
    match /users/{userId} {
      allow read: if isAuth();
      allow create, delete: if isOwner(userId);
      allow update: if isOwner(userId)
        || (isAuth()
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['followers_count']));
    }

    // posts: 非表示でないものを全員に公開。自分の投稿は常に読める。作成/更新/削除は投稿者のみ。
    // reports_count の更新は誰でも可（通報時の加算）
    match /posts/{postId} {
      allow read: if resource.data.is_hidden == false || resource.data.user_id == request.auth.uid;
      allow create: if isAuth()
        && request.auth.uid == request.resource.data.user_id;
      allow update: if isAuth()
        && (resource.data.user_id == request.auth.uid
          || request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['reports_count', 'likes_count']));
      allow delete: if isAuth() && resource.data.user_id == request.auth.uid;

      match /items/{itemId} {
        allow read: if true;
        allow write: if isAuth()
          && get(/databases/$(database)/documents/posts/$(postId)).data.user_id == request.auth.uid;
      }
    }

    // likes: 自分のいいねのみ作成・削除
    match /likes/{likeId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.auth.uid == request.resource.data.user_id;
      allow delete: if isAuth() && request.auth.uid == resource.data.user_id;
    }

    // follows: 自分のフォローのみ作成・削除
    match /follows/{followId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.auth.uid == request.resource.data.follower_id;
      allow delete: if isAuth() && resource.data.follower_id == request.auth.uid;
    }

    // blocks: 自分がブロックしたユーザーの管理
    // read: 認証済み全員可（クエリでblocker_id==自分でフィルタするため）
    // create/delete: blocker_idが自分のドキュメントのみ
    match /blocks/{blockId} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.blocker_id == request.auth.uid;
      allow delete: if isAuth() && resource.data.blocker_id == request.auth.uid;
    }

    // reports: 1人1回のみ作成。読み取りは禁止（運営管理画面時に修正）
    match /reports/{reportId} {
      allow create: if isAuth()
        && request.auth.uid == request.resource.data.user_id
        && !exists(/databases/$(database)/documents/reports/$(reportId));
      allow read, update, delete: if false;
    }

    // notifications: 自分宛ての通知のみ読み取り可能。is_readのみ更新可能。自分の通知は削除可能。
    match /notifications/{notificationId} {
      allow read: if isAuth() && resource.data.user_id == request.auth.uid;
      allow create: if false;  // Cloud Functionsのみ作成可能
      allow update: if isAuth()
        && resource.data.user_id == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['is_read']);
      allow delete: if isAuth() && resource.data.user_id == request.auth.uid;
    }

    // calendar_entries: 自分のエントリのみ読み書き可。is_publicがtrueのエントリは他ユーザーも読み取り可。
    match /calendar_entries/{userId}/entries/{entryId} {
      allow read: if isOwner(userId) || (isAuth() && resource.data.is_public == true);
      allow create, update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    // brands: 全認証ユーザーに読み取り可。書き込みはConsole/Adminのみ
    match /brands/{brandId} {
      allow read: if isAuth();
      allow write: if false;
    }

    // affiliate_links: 全認証ユーザーに読み取り可
    match /affiliate_links/{linkId} {
      allow read: if isAuth();
      allow write: if false;
    }

    // shopping_portals: 全認証ユーザーに読み取り可。書き込みはConsole/Adminのみ
    match /shopping_portals/{portalId} {
      allow read: if isAuth();
      allow write: if false;
    }

    // config: 全認証ユーザーに読み取り可。書き込みはConsole/Adminのみ
    match /config/{configId} {
      allow read: if isAuth();
      allow write: if false;
    }

    // デフォルト: すべて禁止
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
